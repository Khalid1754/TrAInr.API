# Kopiera till .env och fyll i. .env checkas inte in i git.

# Gratis och snabb AI-nyckel från Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Valfritt: Groq-modell (standard: openai/gpt-oss-120b, snabbare: openai/gpt-oss-20b)
GROQ_MODEL=

# Gratis AI-nyckel från Google: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Valfritt: snabbare Gemini-modell, t.ex. gemini-3.5-flash-lite (standard: gemini-3.6-flash)
GEMINI_MODEL=

# Valfritt: minimal, low, medium eller high. Tomt = minimal för kalorier/måltid, low för schema.
GEMINI_THINKING_LEVEL=

# Valfritt: Claude-nyckel från https://console.anthropic.com (kräver krediter)
ANTHROPIC_API_KEY=

# Valfritt: tvinga leverantör, "groq", "gemini" eller "claude". Tomt = första med nyckel: Claude, Groq, Gemini.
AI_PROVIDER=

# Valfritt: kod som krävs för att skapa konto i appen. Tomt = vem som helst på ditt nätverk kan skapa konto.
INVITE_CODE=

SA_PASSWORD=TrAInr_Dev123!
